{
  "packageId": "com.cravecourier.app",
  "host": "www.cravecourier.in",
  "name": "CraveCourier",
  "launcherName": "CraveCourier",
  "themeColor": "#FF6B35",
  "navigationColor": "#FFFFFF",
  "backgroundColor": "#FFFFFF",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://www.cravecourier.in/icons/pwa-512x512.png",
  "maskableIconUrl": "https://www.cravecourier.in/icons/maskable-icon-512x512.png",
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "signingKey": {
    "path": "./crave-release-key.keystore",
    "alias": "crave-key"
  },
  "splashScreenFadeOutDuration": 300,
  "enableSiteSettingsShortcut": true,
  "shortcuts": [
    {
      "name": "Order Hot Food",
      "shortName": "Food",
      "url": "/products?type=food",
      "icon": "https://www.cravecourier.in/icons/pwa-192x192.png"
    },
    {
      "name": "Fresh Groceries",
      "shortName": "Grocery",
      "url": "/products?type=grocery",
      "icon": "https://www.cravecourier.in/icons/pwa-192x192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://www.cravecourier.in/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {
    "playBilling": {
      "enabled": false
    },
    "locationDelegation": {
      "enabled": true
    }
  },
  "alphaDependencies": {
    "enabled": false
  }
}

