{
  "name": "crave-server",
  "version": "1.0.0",
  "description": "Production-ready Food & Grocery Delivery Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:catalogue": "node src/seed/seedGroceryCatalogue.js",
    "seed:all": "node src/seed/seed.js && node src/seed/seedGroceryCatalogue.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,json}\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4",
    "stripe": "^23.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
