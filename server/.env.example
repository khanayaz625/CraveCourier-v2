NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/crave_db

# Security & Tokens
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars_crave_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_min_32_chars_crave_refresh
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_secret_string_crave_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_cli_webhook_secret
STRIPE_CURRENCY=usd

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# Brevo Transactional Email (OTP)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
BREVO_SENDER_NAME="Crave Courier"

# Mobile SMS OTP Gateways (Configure at least one for SMS OTP delivery)
# 1. Primary: 2Factor.in (Indian Transactional OTP)
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=

# 2. Fallback: Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# 3. Optional: MSG91 / Twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

